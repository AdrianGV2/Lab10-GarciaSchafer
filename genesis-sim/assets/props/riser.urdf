<?xml version="1.0" ?>
<!-- Plataforma fija para elevar objetos pequenos hasta la altura que el
     brazo pueda alcanzar. A diferencia de un "objects: box" (siempre un
     cuerpo libre en este simulador), un prop URDF puede montarse fixed. -->
<robot name="riser">
	<link name="plataforma">
		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="5.0"/>
			<inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5"/>
		</inertial>
		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<box size="0.10 0.30 0.13"/>
			</geometry>
		</collision>
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<box size="0.10 0.30 0.13"/>
			</geometry>
			<material name="plataforma_mat">
				<color rgba="0.35 0.35 0.35 1.0"/>
			</material>
		</visual>
	</link>
</robot>
