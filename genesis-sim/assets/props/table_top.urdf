<?xml version="1.0" ?>
<!-- Superficie/tablero de la mesa. Separado de las patas para aplicar materiales independientes. -->
<robot name="table_top">
	<link name="tablero">
		<inertial>
			<origin rpy="0 0 0" xyz="0 0 1.0"/>
			<mass value="10.0"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
		</inertial>
		<collision>
			<origin rpy="0 0 0" xyz="0 0 1.0"/>
			<geometry>
				<box size="1.5 0.8 0.03"/>
			</geometry>
		</collision>
		<visual>
			<origin rpy="0 0 0" xyz="0 0 1.0"/>
			<geometry>
				<box size="1.5 0.8 0.03"/>
			</geometry>
			<material name="tablero_mat">
				<color rgba="0.12 0.12 0.12 1.0"/>
			</material>
		</visual>
	</link>
</robot>
