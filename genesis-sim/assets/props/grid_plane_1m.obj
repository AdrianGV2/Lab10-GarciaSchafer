# Plano plano 1m x 1m centrado en (0,0,0) con coordenadas UV correctas
# Vertices: X e Y de -0.5 a +0.5 → total 1m x 1m
v -0.5 -0.5  0.0
v  0.5 -0.5  0.0
v  0.5  0.5  0.0
v -0.5  0.5  0.0

# Coordenadas UV: mapea la imagen exactamente sobre la superficie
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normal apuntando hacia arriba (Z+)
vn 0.0 0.0 1.0

# Dos triángulos que forman el cuadrado con UV
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
